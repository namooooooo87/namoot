# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HttpOnly admin session cookies.
# Set a long random string in production.
SESSION_SECRET="change-this-to-a-secure-random-string"

# Optional: Pre-seed the sole admin account via environment variables.
# If omitted, the first visitor to /admin/login can complete the one-time initial setup.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="관리자"
